    "version": "0.2.0",
    "configurations": [

        {
            "name": "Launch startday",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}",
            "args": ["startday"],
        },
        {
            "name": "Launch add entry",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}",
            "args": ["add", "entry", "Adding An Entry"],
        },
        {
            "name": "Launch add bullet",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}",
            "args": ["add", "bullet", "Adding a bullet"],
        },
        {
            "name": "Launch TUI",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}",
            "args": [ "tui" ],
        },
        {
            "name": "Launch config",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}",
            "args": ["config", "print"],
        }
    ]
}
